{
  "private": true,
  "name": "@ttsc/benchmark-graph",
  "version": "0.28.2",
  "description": "Graph benchmark harness for @ttsc/graph and its comparators.",
  "type": "module",
  "devDependencies": {
    "@types/node": "catalog:utils",
    "typescript": "catalog:typescript"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node --experimental-transform-types src/executable/index.ts",
    "agent:claude": "node --experimental-transform-types src/executable/agent-ab.ts",
    "agent:codex": "node --experimental-transform-types src/executable/agent-ab-codex.ts",
    "analyze": "node --experimental-transform-types src/executable/analyze-traces.ts",
    "audit": "node --experimental-transform-types src/executable/audit-codex-traces.ts",
    "index-time": "node --experimental-transform-types src/executable/index-time.ts",
    "manifest": "node --experimental-transform-types src/executable/generate-manifest.ts",
    "publish": "node --experimental-transform-types src/executable/publish.ts",
    "reduce": "node --experimental-transform-types src/executable/reduce.ts",
    "structural": "node --experimental-transform-types src/executable/bench.ts",
    "suite": "node --experimental-transform-types src/executable/run-suite.ts"
  }
}
