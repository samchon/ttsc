{
  "private": true,
  "name": "@ttsc/benchmark-performance",
  "version": "0.30.4",
  "description": "Performance benchmark harness comparing ttsc against tsc, eslint, and prettier.",
  "type": "module",
  "devDependencies": {
    "@types/node": "catalog:utils",
    "typescript": "catalog:typescript"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node --experimental-strip-types --import ../../config/register-typescript-loader.mjs src/executable/index.ts",
    "format": "node --experimental-strip-types --import ../../config/register-typescript-loader.mjs src/executable/index.ts --format-only",
    "lint": "node --experimental-strip-types --import ../../config/register-typescript-loader.mjs src/executable/index.ts --lint-only",
    "merge": "node --experimental-strip-types --import ../../config/register-typescript-loader.mjs src/executable/merge.ts",
    "ttsc-build": "node --experimental-strip-types --import ../../config/register-typescript-loader.mjs src/executable/index.ts --ttsc-build-only"
  }
}
