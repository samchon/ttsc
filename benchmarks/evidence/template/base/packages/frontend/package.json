{
  "private": true,
  "name": "{{frontendPackageName}}",
  "version": "0.1.0",
  "description": "React and Vite frontend for {{name}}",
  "scripts": {
    "build": "rimraf dist && pnpm lint && vite build",
    "dev": "vite --host 0.0.0.0",
    "format": "ttsc format",
    "lint": "ttsc --noEmit",
    "playwright:install": "playwright install chromium",
    "preview": "vite preview --host 0.0.0.0",
    "readme:screens": "pnpm build && playwright test tests/readme.spec.ts",
    "test": "pnpm test:e2e",
    "test:e2e": "pnpm build && playwright test tests/journeys",
    "ui:review": "pnpm build && playwright test tests/ui-review.spec.ts"
  },
  "dependencies": {
    "@nestia/fetcher": "catalog:samchon",
    "@tanstack/react-query": "catalog:frontend",
    "{{apiPackageName}}": "workspace:*",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "react-router-dom": "catalog:frontend",
    "sonner": "catalog:frontend",
    "typia": "catalog:samchon"
  },
  "devDependencies": {
    "@playwright/test": "catalog:frontend",
    "@tailwindcss/vite": "catalog:frontend",
    "@ttsc/lint": "catalog:typescript",
    "@ttsc/unplugin": "catalog:typescript",
    "@types/node": "catalog:utils",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitejs/plugin-react": "catalog:frontend",
    "rimraf": "catalog:utils",
    "tailwindcss": "catalog:frontend",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript",
    "vite": "catalog:frontend"
  }
}
