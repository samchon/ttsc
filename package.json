{
  "private": true,
  "name": "@ttsc/station",
  "version": "0.31.0",
  "description": "Standalone TypeScript-Go compiler, runtime, plugin host, and LSP host workspace.",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --filter lint-contributor-demo -r --workspace-concurrency=1 build",
    "evidence": "pnpm --filter \"./packages/*\" --filter \"./tests/*\" -r --no-bail --workspace-concurrency=1 run evidence",
    "test": "pnpm run test:go && pnpm run test:units",
    "test:go": "node config/test-go.mjs",
    "test:units": "pnpm --filter \"./tests/*\" --filter \"!@ttsc/test-e2e\" -r --no-bail --workspace-concurrency=1 start",
    "test:e2e": "pnpm --filter @ttsc/test-e2e start",
    "format": "pnpm run gen:flags --skip-website && prettier --write --no-error-on-unmatched-pattern \"**/*.ts\" \"**/*.md\" \"**/*.mdx\" \"!website/**\" && pnpm run format:go",
    "format:go": "bash ./.vscode/format-go.sh",
    "gen:flags": "node --experimental-strip-types --import ./config/register-typescript-loader.mjs packages/ttsc/scripts/gen-flags.mts",
    "check:flags": "node packages/ttsc/scripts/check-flags.cjs",
    "experimental": "pnpm experimental:install && pnpm experimental:unplugin",
    "experimental:install": "pnpm --dir experimental/install start",
    "experimental:unplugin": "pnpm --dir experimental/test-unplugin start",
    "package:next": "bash next.bash",
    "release": "bumpp -r",
    "package:latest": "pnpm build && pnpm run package:latest:publish",
    "package:latest:publish": "pnpm --filter=./packages/* --filter=!ttsc -r publish --tag latest --access public --no-git-checks --provenance && pnpm --filter ttsc publish --tag latest --access public --no-git-checks --provenance"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/ttsc"
  },
  "author": "Jeongho Nam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/samchon/ttsc/issues"
  },
  "homepage": "https://ttsc.dev",
  "packageManager": "pnpm@10.6.4",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "catalog:utils",
    "@wrtnlabs/evidence": "catalog:samchon",
    "bumpp": "^10.4.1",
    "prettier": "^3.8.3",
    "prettier-plugin-jsdoc": "^1.8.0",
    "rimraf": "catalog:utils",
    "rollup": "catalog:rollup",
    "ts-legacy": "catalog:typescript",
    "typescript": "catalog:typescript"
  }
}
