+// pinnedTypiaBuildWithCandidateProvenance applies the exact reviewed host
+// extension to a private copy of the pinned source. The Go pin and every other
+// source byte still have to match the installed npm package; this oracle accepts
+// no arbitrary CLI drift and never modifies the module cache or shipped source.
+func pinnedTypiaBuildWithCandidateProvenance(t *testing.T, source string) []byte {
+	t.Helper()
+	root := t.TempDir()
+	file := filepath.Join(root, "native", "cmd", "ttsc-typia", "build.go")
+	if err := os.MkdirAll(filepath.Dir(file), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(file, mustReadBytes(t, filepath.Join(source, "cmd", "ttsc-typia", "build.go")), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	patch := filepath.Join(root, "emit-provenance.patch")
+	if err := os.WriteFile(patch, []byte(pinnedTypiaCandidateProvenancePatch), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	for _, args := range [][]string{{"apply", "--check", patch}, {"apply", patch}} {
+		command := exec.Command("git", append([]string{"-c", "core.autocrlf=false"}, args...)...)
+		command.Dir = root
+		if output, err := command.CombinedOutput(); err != nil {
+			t.Fatalf("apply candidate provenance to pinned typia: %v\n%s", err, output)
+		}
+	}
+	return mustReadBytes(t, file)
+}
