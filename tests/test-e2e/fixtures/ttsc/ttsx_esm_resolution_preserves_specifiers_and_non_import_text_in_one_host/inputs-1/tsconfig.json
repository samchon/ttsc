{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "paths": {
      "@lib/*": [
        "./src/paths/lib/*"
      ],
      "exact-lib": [
        "./src/paths/lib/exact.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
