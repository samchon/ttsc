{
  "private": true,
  "name": "@ttsc/test-unplugin",
  "version": "0.28.6",
  "description": "Adapter entrypoint and transform tests for @ttsc/unplugin.",
  "type": "module",
  "scripts": {
    "integration": "node --disable-warning=ExperimentalWarning --import ../../scripts/register-extensionless-ts-loader.mjs --experimental-transform-types src/index.ts --layer=integration",
    "start": "node --disable-warning=ExperimentalWarning --import ../../scripts/register-extensionless-ts-loader.mjs --experimental-transform-types src/index.ts",
    "unit": "node --disable-warning=ExperimentalWarning --import ../../scripts/register-extensionless-ts-loader.mjs --experimental-transform-types src/index.ts --layer=unit"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@ttsc/testing": "workspace:*",
    "@types/node": "catalog:utils",
    "esbuild": "^0.25.12",
    "rollup": "^4.60.3",
    "ttsc": "workspace:*",
    "typescript": "catalog:typescript",
    "vite": "^7.3.5",
    "webpack": "^5.99.0"
  }
}
