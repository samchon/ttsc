{
  "name": "@ttsc/darwin-x64",
  "version": "0.30.4",
  "description": "macOS x64 native ttsc/ttscserver/ttscgraph binaries and bundled Go compiler for ttsc.",
  "os": [
    "darwin"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "evidence": "evidence",
    "build": "node ../ttsc/build/platform-package.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/ttsc"
  },
  "author": "Jeongho Nam",
  "license": "MIT",
  "files": [
    "bin",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "executableFiles": [
      "./bin/ttsc",
      "./bin/ttscserver",
      "./bin/ttscgraph",
      "./bin/go/bin/go",
      "./bin/go/bin/gofmt",
      "./bin/go/pkg/tool/darwin_amd64/asm",
      "./bin/go/pkg/tool/darwin_amd64/cgo",
      "./bin/go/pkg/tool/darwin_amd64/compile",
      "./bin/go/pkg/tool/darwin_amd64/cover",
      "./bin/go/pkg/tool/darwin_amd64/fix",
      "./bin/go/pkg/tool/darwin_amd64/link",
      "./bin/go/pkg/tool/darwin_amd64/preprofile",
      "./bin/go/pkg/tool/darwin_amd64/vet"
    ]
  },
  "devDependencies": {
    "@wrtnlabs/evidence": "catalog:samchon"
  }
}
