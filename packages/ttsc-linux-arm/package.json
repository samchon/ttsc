{
  "name": "@ttsc/linux-arm",
  "version": "0.31.0",
  "description": "Linux arm native ttsc/ttscserver/ttscgraph binaries and bundled Go compiler for ttsc.",
  "os": [
    "linux"
  ],
  "cpu": [
    "arm"
  ],
  "scripts": {
    "evidence": "evidence",
    "build": "node ../ttsc/build/platform-package.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/ttsc"
  },
  "author": "Jeongho Nam",
  "license": "MIT",
  "files": [
    "bin",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "executableFiles": [
      "./bin/ttsc",
      "./bin/ttscserver",
      "./bin/ttscgraph",
      "./bin/go/bin/go",
      "./bin/go/bin/gofmt",
      "./bin/go/pkg/tool/linux_arm/asm",
      "./bin/go/pkg/tool/linux_arm/cgo",
      "./bin/go/pkg/tool/linux_arm/compile",
      "./bin/go/pkg/tool/linux_arm/cover",
      "./bin/go/pkg/tool/linux_arm/fix",
      "./bin/go/pkg/tool/linux_arm/link",
      "./bin/go/pkg/tool/linux_arm/preprofile",
      "./bin/go/pkg/tool/linux_arm/vet"
    ]
  },
  "devDependencies": {
    "@wrtnlabs/evidence": "catalog:samchon"
  }
}
