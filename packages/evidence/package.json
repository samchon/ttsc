{
  "name": "@ttsc/evidence",
  "version": "0.28.2",
  "description": "Evidence-graph lint contributor for @ttsc/lint: declare provenance with a JSDoc @evidence tag and fail the build when it is missing or dangling.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "lib",
    "native/*.go",
    "!native/*_test.go"
  ],
  "scripts": {
    "build": "rimraf lib && tsc"
  },
  "keywords": [
    "ttsc",
    "lint",
    "evidence",
    "provenance",
    "traceability",
    "jsdoc",
    "typescript",
    "openapi",
    "swagger",
    "prisma"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/ttsc"
  },
  "author": "Jeongho Nam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/samchon/ttsc/issues"
  },
  "peerDependencies": {
    "@ttsc/lint": ">=0.24.0"
  },
  "devDependencies": {
    "@ttsc/lint": "workspace:*",
    "@types/node": "catalog:utils",
    "rimraf": "catalog:utils",
    "ttsc": "workspace:*",
    "typescript": "catalog:typescript"
  },
  "dependencies": {
    "@prisma/prisma-schema-wasm": "catalog:prisma",
    "@typia/interface": "catalog:samchon",
    "@typia/utils": "catalog:samchon",
    "yaml": "catalog:utils"
  },
  "homepage": "https://ttsc.dev"
}
