diff --git a/packages/core/test/typia_go_pin_matches_npm_typia_test.go b/packages/core/test/typia_go_pin_matches_npm_typia_test.go
--- a/packages/core/test/typia_go_pin_matches_npm_typia_test.go
+++ b/packages/core/test/typia_go_pin_matches_npm_typia_test.go
@@ -33,5 +33,9 @@
 //     `LICENSE` (in the Go module zip, absent from the npm package) and
 //     `_test.go` files.
 //  4. Assert the pnpm catalog the published packages depend through pins
 //     typia to exactly that installed release, not a range (#1663).
+//
+// A compatibility consumer may intentionally patch the installed native command.
+// In that case apply its explicit reviewed patch to an independent copy of the
+// pinned source before the same complete comparison; never mutate the Go cache.
 func TestTypiaGoPinMatchesNpmTypia(t *testing.T) {
@@ -144,5 +148,19 @@
 	if downloaded.Dir == "" {
 		t.Fatalf("go mod download returned no directory for %s@%s", typiaNativeModulePath, version)
 	}
+	if patch := os.Getenv("TTSC_TYPIA_NATIVE_PATCH"); patch != "" {
+		expected := t.TempDir()
+		native := filepath.Join(expected, "native")
+		if err := os.CopyFS(native, os.DirFS(downloaded.Dir)); err != nil {
+			t.Fatalf("copy independently pinned typia source: %v", err)
+		}
+		command := exec.Command("git", "-c", "core.autocrlf=false", "apply", "--include=native/**", patch)
+		command.Dir = expected
+		command.Env = append(os.Environ(), "GIT_CEILING_DIRECTORIES="+filepath.Dir(expected))
+		if output, err := command.CombinedOutput(); err != nil {
+			t.Fatalf("apply reviewed typia native patch to pinned source: %v\n%s", err, output)
+		}
+		return native
+	}
 	return downloaded.Dir
 }
